# ─────────────────────────────────────────────────────────────────────────────
# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub OAuth credentials
#
# 1. Copy this file to .env  (cp .env.example .env)
# 2. Fill in your real values from:
#    https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
# 3. NEVER commit .env — it is listed in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

CDSE_CLIENT_ID=your-client-id-here
CDSE_CLIENT_SECRET=your-client-secret-here
